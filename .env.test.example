# NanoNymNault E2E Test Environment Variables
# Copy this file to .env.test and fill in your values.
# .env.test is gitignored — never commit real seeds!

# Required for roundtrip tests (nano_ and nnym_).
# 64-char hex seed with funded accounts on the target network.
# If unset, roundtrip tests are skipped.
NANO_TEST_SEED=

# Optional: override Nano RPC URL (default: https://rpc.nano.org)
# NANO_RPC_URL=

# Optional: override Playwright browser path (local dev).
# If unset, Playwright uses its bundled Chromium.
# CHROME_BIN=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
