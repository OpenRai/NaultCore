{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "nault": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": ["src/polyfills.ts"],
            "assets": [
              "src/assets",
              "src/pow.wasm",
              "src/404.html",
              "src/manifest.webmanifest",
              "src/manifest.naultcore.webmanifest"
            ],
            "styles": [
              "src/styles.less"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "qrcode",
              "bip39",
              "@zxing/library",
              "bignumber.js",
              "nanocurrency",
              "hw-app-nano",
              "crypto-js",
              "blakejs",
              "nanocurrency-web",
              "bignumber.js",
              "u2f-api",
              "create-hash",
              "randombytes",
              "pbkdf2",
              "zxcvbn",
              "punycode",
              "querystring",
              "hw-transport-webusb",
              "hw-transport-web-ble",
              "tweetnacl",
              "hermes-channel",
              "nano-base32",
              "events",
              "semver"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "define": {
              "FEATURE_NANONYMS": "false"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "desktop": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "define": {
                "FEATURE_NANONYMS": "false"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.desktop.ts"
                }
              ]
            },
            "naultcore": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.naultcore.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "naultcore-dev": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.naultcore-dev.ts"
                }
              ],
              "serviceWorker": false
            },
            "naultcore-preview": {
              "index": "src/index.preview.html",
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.naultcore-preview.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "naultcore-e2e": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.naultcore-e2e.ts"
                }
              ],
              "serviceWorker": false
            },
            "nanonyms": {
              "define": {
                "FEATURE_NANONYMS": "true"
              }
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "nault:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "nault:build:production"
            },
            "desktop": {
              "buildTarget": "nault:build:desktop"
            },
            "naultcore": {
              "buildTarget": "nault:build:naultcore"
            },
            "naultcore-dev": {
              "buildTarget": "nault:build:naultcore-dev"
            },
            "naultcore-preview": {
              "buildTarget": "nault:build:naultcore-preview"
            },
            "naultcore-e2e": {
              "buildTarget": "nault:build:naultcore-e2e"
            },
            "nanonyms": {
              "buildTarget": "nault:build:nanonyms"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "nault:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "karmaConfig": "./karma.conf.js",
            "polyfills": ["src/polyfills.ts", "zone.js/testing"],
            "tsConfig": "src/tsconfig.spec.json",
            "include": ["src/**/*.spec.ts"],
            "scripts": [],
            "styles": [
              "src/styles.less"
            ],
            "assets": [
              "src/assets",
              "src/pow.wasm",
              "src/manifest.webmanifest",
              "src/manifest.naultcore.webmanifest"
            ],
            "define": {
              "FEATURE_NANONYMS": "false"
            }
          },
          "configurations": {
            "nanonyms": {
              "define": {
                "FEATURE_NANONYMS": "true"
              }
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "less",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "app",
      "type": "directive"
    },
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  }
}
