# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/dist-desktop
/tmp
/out-tsc
/desktop-app/dist
/desktop-app/build
/packages/*/dist
/packages/*/tsconfig.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/

# AI tool state (local configs + node_modules — never track these)
.kilo/
.opencode/

# misc
/.angular
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
npm-test.out
npm-test.err
testem.log
yarn-error.log
/typings

# e2e
/e2e/*.js
/e2e/*.map

# System Files
.DS_Store
Thumbs.db

# Debug
debug.log*-debug-*.log

# Generated files
src/environments/version.ts
.beads/

# Playwright / test results (ignored by default)
playwright-report/
test-results/
tests-playwright-results/

# Stray lockfile — this project uses pnpm, not bun
bun.lock

# Test secrets — never commit
.env.test

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
