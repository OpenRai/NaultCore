{
  "name": "@nanonyms/core",
  "version": "0.1.0",
  "description": "NanoNym use-case API without infrastructure adapters",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "pnpm pack --pack-destination /tmp/nanonyms-pack"
  },
  "dependencies": {
    "@nanonyms/crypto": "workspace:*",
    "@nanonyms/protocol": "workspace:*"
  }
}
