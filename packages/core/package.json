{
  "name": "@nanonyms/core",
  "version": "0.1.0",
  "description": "NanoNym use-case API without infrastructure adapters",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist",
    "test": "node --input-type=module -e \"import('./dist/index.js').then(() => console.log('core ok'))\""
  },
  "dependencies": {
    "@nanonyms/crypto": "workspace:*",
    "@nanonyms/protocol": "workspace:*"
  }
}
