{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "baseUrl": "./",
    "paths": {
      "@nanonyms/protocol": [
        "../packages/protocol/src/index.ts"
      ],
      "@nanonyms/crypto": [
        "../packages/crypto/src/index.ts"
      ],
      "@nanonyms/core": [
        "../packages/core/src/index.ts"
      ]
    },
    "types": ["jasmine", "node"]
  },
  "files": ["test.ts", "polyfills.ts"],
  "include": ["**/*.spec.ts", "**/*.d.ts", "../packages/protocol/src/**/*.ts", "../packages/crypto/src/**/*.ts", "../packages/core/src/**/*.ts"],
  "exclude": ["node_modules"]
}
